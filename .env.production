# ===== PRODUCCIÓN CONFIG =====
# IMPORTANTE: Estas variables se usan en producción
# Nunca commitees .env.production a GitHub

# ===== TELEGRAM =====
VITE_TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui
VITE_TELEGRAM_WEBHOOK_URL=https://go-botcaza-ai.onrender.com/webhook

# ===== API BACKEND (si aplica) =====
VITE_API_URL=https://api.go-botcaza-ai.onrender.com
VITE_API_TIMEOUT=30000

# ===== GEMINI AI (Opcional) =====
# Para generar cotizaciones inteligentes con IA
VITE_GEMINI_API_KEY=tu_gemini_key_aqui

# ===== ANALYTICS =====
VITE_GA_ID=G_XXXXXXXXXX
VITE_SENTRY_DSN=https://tu_sentry_key@sentry.io/project

# ===== SEGURIDAD =====
VITE_ALLOW_DOMAINS=go-botcaza-ai.onrender.com,tudominio.com
VITE_ENCRYPTION_KEY=tu_key_encriptacion_aqui
VITE_ENABLE_CSP=true

# ===== FEATURES =====
VITE_ENABLE_CLOUD_SYNC=true
VITE_ENABLE_PREMIUM=true
VITE_TRIAL_DAYS=7

# ===== DEBUG (desactivar en prod) =====
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error